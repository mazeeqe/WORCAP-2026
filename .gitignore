# Credenciais do Kaggle - NUNCA versionar
kaggle.json
access_token
.kaggle/

# Dados baixados (grandes, cada um baixa localmente com o próprio script)
data/
*.nc
*.csv

# Resumos gerados por eda.py (derivados, cada um regenera localmente)
eda_output/

# Checkpoints de modelo e objetos PCA (grandes/binarios, cada um regenera com
# python3 -m src.models.pca_lstm.train) - historico/metricas/grades de amostra ficam
# versionados em models/ para o notebook de resultados nao depender de retreino
models/**/*.pt
models/**/*.joblib
!models/**/*.csv

# Caches de fold da CV do ENSO (varios GB, resumiveis, cada um regenera
# rodando enso_correction_cv.py / cv_ensemble.py de novo) - metricas pequenas
# (history.csv, report.json, screening.log) continuam versionadas acima
models/_cv/**/*.npz
models/_enso_cv_folds/**/*.npz

# Python
__pycache__/
*.pyc
.venv/
venv/
env/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Editor / SO
.vscode/
.idea/
.DS_Store
